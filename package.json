{
  "name": "krusch-context-mcp",
  "version": "1.8.0",
  "type": "module",
  "description": "Local MCP server: five tools to store, retrieve, and retire project decisions. SQLite by default.",
  "main": "src/index.js",
  "bin": {
    "krusch-context-mcp": "bin/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "bin",
    "db",
    "templates",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example",
    "docker-compose.yml"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "init": "node bin/cli.js init",
    "health": "node bin/cli.js health",
    "test": "node --test tests/*.test.js",
    "docs:generate": "node scripts/generate_docs.js",
    "snapshot": "node scripts/snapshot.js",
    "sync-all": "node scripts/sync_all_projects.js",
    "bench:memory": "node scripts/benchmark_memory_eval.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "context-engine",
    "coding-agents",
    "cursor-ide",
    "claude-code",
    "windsurf",
    "episodic-memory",
    "memory-hygiene",
    "sqlite"
  ],
  "author": "kruschdev",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "pg": "^8.20.0"
  },
  "overrides": {
    "fast-uri": "4.1.3"
  }
}

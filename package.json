{
  "name": "krusch-context-mcp",
  "version": "2.0.0",
  "type": "module",
  "description": "Local MCP server: five tools to store, retrieve, and retire project decisions. SQLite by default.",
  "main": "src/index.js",
  "bin": {
    "krusch-context-mcp": "bin/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "bin",
    "templates",
    "db/schema.sql",
    "docs/TOOL_REFERENCE.md",
    "docs/ARCHITECTURE.md",
    "docs/SETUP.md",
    "docs/MIGRATION.md",
    "docs/WHAT_MAKES_IT_SPECIAL.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "init": "node bin/cli.js init",
    "health": "node bin/cli.js health",
    "test": "node --test tests/*.test.js",
    "docs:generate": "node scripts/generate_docs.js",
    "bench:memory": "node scripts/benchmark_memory_eval.js",
    "bench:beam": "node scripts/benchmark_beam_eval.js",
    "bench:beam:official": "node scripts/benchmark_official_beam.js",
    "bench:beam:verify": "node benchmarks/verify_zero_leakage.js",
    "bench:beam:long": "node scripts/benchmark_official_beam_long.js",
    "bench:beam:verify:long": "node benchmarks/verify_zero_leakage_long.js --split=500K && node benchmarks/verify_zero_leakage_long.js --split=1M && node benchmarks/verify_zero_leakage_long.js --split=10M"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "context-engine",
    "coding-agents",
    "cursor-ide",
    "claude-code",
    "windsurf",
    "episodic-memory",
    "memory-hygiene",
    "sqlite"
  ],
  "author": "kruschdev",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dotenv": "^16.4.7"
  },
  "optionalDependencies": {
    "pg": "^8.20.0"
  },
  "overrides": {
    "fast-uri": "4.1.3",
    "hono": "^4.13.10"
  }
}

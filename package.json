{
  "name": "krusch-context-mcp",
  "version": "1.5.0",
  "type": "module",
  "description": "11-tool MCP context engine (retrieve, memory, AST/symbol search, nuggets, auditor) with optional extended (31) and full (64) research tiers.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --env-file=.env --test tests/*.test.js",
    "test:smoke": "node --env-file=.env tests/test_client.js && node --env-file=.env tests/test_v2_memory.js && node --env-file=.env tests/test_v2_lens_graph.js && node --env-file=.env tests/test_v2_action_memory.js && node --env-file=.env tests/test_proactive.js && node --env-file=.env tests/test_ai_watch_integrations.js",
    "test:aiwatch": "node --env-file=.env tests/test_ai_watch_integrations.js",
    "test:cloud": "node --env-file=.env tests/test_cloud_integration.js && node --env-file=.env tests/test_polygres_cloud.js",
    "snapshot": "node scripts/snapshot.js",
    "sync-all": "node scripts/sync_all_projects.js",
    "bench:memory": "node --env-file=.env scripts/benchmark_memory_eval.js",
    "eval:accuracy": "node --env-file=.env scripts/eval_accuracy.js",
    "export:polygres": "node scripts/export_to_polygres.js",
    "install-hook": "node scripts/install_git_hook.js"
  },
  "keywords": [
    "mcp",
    "semantic-search",
    "pgvector",
    "context-engine"
  ],
  "author": "kruschdev",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.7",
    "ml-pca": "^4.1.1",
    "pg": "^8.20.0"
  }
}

{
  "name": "krusch-context-mcp",
  "version": "1.7.0",
  "type": "module",
  "description": "Sovereign 13-tool core MCP context engine (working memory, structural code retrieval, steering nuggets) with modular companion extensions.",
  "main": "src/index.js",
  "bin": {
    "krusch-context-mcp": "src/index.js",
    "krusch-semantic-router": "src/extensions/semantic-router/server.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "db",
    "templates",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example",
    "docker-compose.yml"
  ],
  "scripts": {
    "start": "node src/index.js",
    "start:cloud": "node src/extensions/polygres-cloud/server.js",
    "start:router": "node src/extensions/semantic-router/server.js",
    "start:law": "node src/extensions/law/server.js",
    "start:nexus": "node src/extensions/nexus/server.js",
    "start:biz": "node src/extensions/biz/server.js",
    "start:sovereign": "KRUSCH_PROFILE=sovereign node src/index.js",
    "start:triad": "KRUSCH_PROFILE=sovereign node src/index.js",
    "start:ecosystem": "KRUSCH_PROFILE=ecosystem node src/index.js",
    "test": "node --env-file=.env --test tests/*.test.js",
    "test:smoke": "node --env-file=.env tests/test_client.js && node --env-file=.env tests/test_proactive.js",
    "test:cloud": "node --env-file=.env tests/test_cloud_integration.js && node --env-file=.env tests/test_polygres_cloud.js",
    "snapshot": "node scripts/snapshot.js",
    "sync-all": "node scripts/sync_all_projects.js",
    "bench:memory": "node --env-file=.env scripts/benchmark_memory_eval.js",
    "eval:accuracy": "node --env-file=.env scripts/eval_accuracy.js",
    "eval:foreign": "node --env-file=.env scripts/eval_accuracy.js evals/fixtures/express_benchmark_10.json express",
    "export:polygres": "node scripts/export_to_polygres.js",
    "install-hook": "node scripts/install_git_hook.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "context-engine",
    "coding-agents",
    "cursor-ide",
    "claude-code",
    "windsurf",
    "semantic-search",
    "pgvector",
    "episodic-memory",
    "memory-hygiene"
  ],
  "author": "kruschdev",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.7",
    "ml-pca": "^4.1.1",
    "pg": "^8.20.0"
  },
  "overrides": {
    "fast-uri": "4.1.3"
  }
}

# ==============================================================================
# Krusch Context MCP Configuration
# ==============================================================================

# --- Tool Exposure Profile ---
# Controls how many tools are exposed in the agent's MCP tool menu:
# - 'core' (default, 11 tools): Lean context essentials (retrieve, add_memory, search_memory, compile_state, nuggets, symbols, health, proactive_nudge)
# - 'extended' (31 tools): Core + memory lifecycle, git exploration, skills, docs, and session reviews
# - 'full' (64 tools): All tools including Company Brain v2, AI Watch research engines, and cloud endpoints
KRUSCH_PROFILE="core"

# --- Option 1: Local / Self-Hosted PostgreSQL + Ollama (Local-First Sovereign Stack) ---
# Direct PostgreSQL connection string:
DATABASE_URL="postgresql://krusch:password@localhost:5432/kruschdb"

# Or discrete connection parameters:
# DB_HOST="localhost"
# DB_PORT=5432
# DB_NAME="kruschdb"
# DB_USER="krusch"
# DB_PASSWORD="password"

# Local Ollama endpoint for vector embeddings (bge-large, 1024 dims) and tags (llama3.2):
OLLAMA_URL="http://127.0.0.1:11434"

# --- Option 2: Polygres Cloud (Turnkey Managed Database & In-Engine Embeddings) ---
# Connect to Polygres Cloud for zero-client embeddings and managed pgContext:
# POLYGRES_PROJECT_ID="your_polygres_project_id"
# POLYGRES_RUNTIME_URL="https://your_polygres_project_id.api.db.polygres.com/v1"
# POLYGRES_API_KEY="sk-polygres-your-api-key"
# DATABASE_URL="postgresql://user:pass@app.polygres.com:5432/your_db?sslmode=require"

# --- Option 3: Custom External Embeddings / Chat (OpenRouter, OpenAI, vLLM) ---
# EMBEDDING_URL="https://openrouter.ai/api/v1/embeddings"
# EMBEDDING_API_KEY="sk-or-v1-your-openrouter-key"
# EMBED_MODEL="baai/bge-large-en-v1.5"

# COMPLETION_URL="http://127.0.0.1:8080/v1/chat/completions"
# COMPLETION_API_KEY=""
# COMPLETION_MODEL="llama3.2"

# --- Embedding dimensions (must match Postgres VECTOR columns) ---
# Local default: Ollama bge-large / BAAI bge-large-en-v1.5 = 1024 dims
# Schema in src/index.js and SQLite paths assumes VECTOR(1024).
#
# Do NOT point EMBED_MODEL at these without a new column + full reindex:
#   text-embedding-3-small          = 1536
#   text-embedding-3-large          = 3072 (or 256/1024/1536 if you set dimensions=)
#   text-embedding-ada-002          = 1536
#   polygres in-engine 3-small/large = same as OpenAI family above
#
# Mixing 1024-d rows with 1536-d queries will fail at <=> or silently
# compare incompatible spaces. After changing models: drop/rebuild
# embedding columns and rerun `npm run snapshot`.
EMBED_DIMS=1024


# --- Polygres.com Cloud Database & Runtime API (DEFAULT OUT OF THE BOX) ---
# Connect to Polygres Cloud: embeddings, vector search, and graph are handled 100% in-engine.
# No separate embedding API, no extra keys, and Polygres picks up the embedding bill!
POLYGRES_PROJECT_ID="your_polygres_project_id"
POLYGRES_RUNTIME_URL="https://your_polygres_project_id.api.db.polygres.com/v1"
POLYGRES_API_KEY="sk-polygres-your-api-key"

# Native PostgreSQL Connection String (Optional Direct Postgres Access)
DATABASE_URL="postgresql://username:password@app.polygres.com:5432/your_database?sslmode=require"

# Option 2: Discrete parameters for local Postgres
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="kruschdb"
DB_USER="krusch"
DB_PASSWORD="password"

# --- Optional: Bring Your Own Embedding Provider (e.g. OpenRouter BGE-large) ---
# If you want to use an external embedding model (like BAAI BGE-large) instead of Polygres in-engine:
# EMBEDDING_URL="https://openrouter.ai/api/v1/embeddings"
# EMBEDDING_API_KEY="sk-or-v1-your-openrouter-key"
# EMBED_MODEL="baai/bge-large-en-v1.5"

# Option 3: Local / Homelab Ollama (Fallback if Polygres Cloud & EMBEDDING_URL are omitted)
OLLAMA_URL="http://127.0.0.1:11434"

# --- Custom Chat / Completion Endpoints (Optional) ---
# COMPLETION_URL="http://127.0.0.1:8080/v1/chat/completions"
# COMPLETION_API_KEY=""
# COMPLETION_MODEL="llama3.2"


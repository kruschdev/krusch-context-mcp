# ==============================================================================
# Krusch Context MCP (v1.8.0) Configuration
# ==============================================================================
# Default out-of-the-box mode requires ZERO configuration or external services.
# The server runs 100% locally on Node 22 native SQLite (.agent/context.db).
#
# Only create a .env file if you wish to override storage or embedding defaults.

# ------------------------------------------------------------------------------
# 1. Storage Backend (Default: sqlite)
# ------------------------------------------------------------------------------
# STORAGE_MODE="sqlite"        # 'sqlite' (default, zero-Docker) or 'postgres' (fleet mode)
# SQLITE_PATH=".agent/context.db" # Custom SQLite path (defaults to .agent/context.db)

# Optional: PostgreSQL Fleet Connection (only when STORAGE_MODE="postgres")
# DATABASE_URL="postgresql://krusch:password@localhost:5432/kruschdb"

# ------------------------------------------------------------------------------
# 2. Embedding Configuration (Optional)
# ------------------------------------------------------------------------------
# If no embedding provider is configured, the server uses deterministic lexical
# keyword extraction, recency scoring, and heuristic tag indexing.
#
# Option A: Local Ollama (bge-large, 1024 dims)
# OLLAMA_URL="http://127.0.0.1:11434"
# EMBED_MODEL="bge-large"
#
# Option B: Cloud OpenRouter (Zero Local VRAM)
# OPENROUTER_API_KEY="sk-or-v1-your-key-here"
# EMBED_MODEL="baai/bge-large-en-v1.5"
#
# Vector dimensions must match your embedding model (default: 1024):
# EMBED_DIMS=1024

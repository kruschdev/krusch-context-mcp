# --- Database Connection (PostgreSQL / Polygres.com) ---
# Option 1: Connection string (e.g., Polygres cloud database)
DATABASE_URL="postgresql://krusch:password@ep-xyz.polygres.com:5432/kruschdb?sslmode=require"

# Option 2: Discrete parameters
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="kruschdb"
DB_USER="krusch"
DB_PASSWORD="password"

# --- Embeddings Pipeline ---
# Option 1: OpenRouter (Cloud BGE-large, ~$0.01 / 1M tokens)
EMBEDDING_URL="https://openrouter.ai/api/v1/embeddings"
EMBEDDING_API_KEY="sk-or-v1-your-openrouter-key"
EMBED_MODEL="baai/bge-large-en-v1.5"

# Option 2: Local / Homelab Ollama (Default fallback if EMBEDDING_URL is omitted)
OLLAMA_URL="http://127.0.0.1:11434"

# --- Custom Chat / Completion Endpoints (Optional) ---
# COMPLETION_URL="http://127.0.0.1:8080/v1/chat/completions"
# COMPLETION_API_KEY=""
# COMPLETION_MODEL="llama3.2"


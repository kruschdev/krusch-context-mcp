# ==============================================================================
# Krusch Context MCP Configuration
# ==============================================================================

# --- Tool Exposure Profile ---
# Controls how many tools are exposed in the agent's MCP tool menu:
# - 'core' (default, 13 tools, ~900 tokens): Lean daily drivers (retrieve, add_memory, supersede_memory, invalidate_memory, search_memory, compile_state, search_code, search_symbols, symbol_graph, nuggets, proactive_nudge, health)
# - 'extended' (26 tools): Core (13) + administrative memory inspection (list, delete, update, consolidate), Git inspection, cited thinking, and nudge feedback (13)
# - 'full' (61 tools): Core + Extended + all 5 companion extensions loaded in-process
# Note: Companion extensions can also be loaded selectively via KRUSCH_EXTENSIONS="company-brain,research" or run as standalone servers.
KRUSCH_PROFILE="core"

# --- Option 1: Local / Self-Hosted PostgreSQL + Ollama (Local-First Sovereign Stack) ---
# Direct PostgreSQL connection string:
DATABASE_URL="postgresql://krusch:password@localhost:5432/kruschdb"

# Or discrete connection parameters:
# DB_HOST="localhost"
# DB_PORT=5432
# DB_NAME="kruschdb"
# DB_USER="krusch"
# DB_PASSWORD="password"

# Local Ollama endpoint for vector embeddings (bge-large, 1024 dims) and tags (llama3.2):
OLLAMA_URL="http://127.0.0.1:11434"

# --- Option 2: Polygres Cloud (Turnkey Managed Database & In-Engine Embeddings) ---
# Connect to Polygres Cloud for zero-client embeddings and managed pgContext:
# POLYGRES_PROJECT_ID="your_polygres_project_id"
# POLYGRES_RUNTIME_URL="https://your_project_id.api.db.polygres.com/v1"
# POLYGRES_API_KEY="sk-polygres-your-api-key"
# DATABASE_URL="postgresql://user:pass@app.polygres.com:5432/your_db?sslmode=require"
#
# NOTE: Polygres Cloud provides managed PostgreSQL storage and in-engine vector embeddings,
# but does not provide generative text completions. For automated episodic memory tagging
# in a zero-local-GPU setup, pair Polygres with an OpenRouter API key:
# OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
# (If omitted, Krusch Context uses deterministic heuristic keyword extraction).

# --- Option 3: OpenRouter Remote Embeddings (Zero Local VRAM Stack) ---
# Run Postgres and MCP server locally, but offload embeddings and tags to OpenRouter.
# Setting OPENROUTER_API_KEY automatically routes vector embeddings to baai/bge-large-en-v1.5 (1024 dims)
# and completions/tagging to meta-llama/llama-3.2-3b-instruct without requiring local GPU VRAM.
# OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
#
# Optional explicit overrides (for vLLM, custom gateways, or alternative models):
# EMBEDDING_URL="https://openrouter.ai/api/v1/embeddings"
# EMBEDDING_API_KEY="sk-or-v1-your-openrouter-key"
# EMBED_MODEL="baai/bge-large-en-v1.5"
# COMPLETION_URL="https://openrouter.ai/api/v1/chat/completions"
# COMPLETION_API_KEY="sk-or-v1-your-openrouter-key"
# COMPLETION_MODEL="meta-llama/llama-3.2-3b-instruct"

# --- Embedding dimensions (must match Postgres VECTOR columns) ---
# Local default: Ollama bge-large / BAAI bge-large-en-v1.5 = 1024 dims
# Schema in src/index.js and SQLite paths assumes VECTOR(1024).
#
# Do NOT point EMBED_MODEL at these without a new column + full reindex:
#   text-embedding-3-small          = 1536
#   text-embedding-3-large          = 3072 (or 256/1024/1536 if you set dimensions=)
#   text-embedding-ada-002          = 1536
#   polygres in-engine 3-small/large = same as OpenAI family above
#
# Mixing 1024-d rows with 1536-d queries will fail at <=> or silently
# compare incompatible spaces. After changing models: drop/rebuild
# embedding columns and rerun `npm run snapshot`.
EMBED_DIMS=1024

